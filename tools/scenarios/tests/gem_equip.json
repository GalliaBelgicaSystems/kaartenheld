{
  "name": "gem_equip",
  "test": true,
  "description": "Manual equip: with the STRAIGHT gem owned, A on the GEM tab sets the equipped bit and the row flips to ON (no auto-equip anywhere on the grant path).",
  "actions": [
    {
      "type": "press",
      "button": "START"
    },
    {
      "type": "wait",
      "frames": 5
    },
    {
      "type": "press",
      "button": "RIGHT"
    },
    {
      "type": "wait",
      "frames": 5
    },
    {
      "type": "press",
      "button": "RIGHT"
    },
    {
      "type": "wait",
      "frames": 5
    },
    {
      "type": "press",
      "button": "RIGHT"
    },
    {
      "type": "wait",
      "frames": 5
    },
    {
      "type": "press",
      "button": "A"
    },
    {
      "type": "wait",
      "frames": 5
    }
  ],
  "assertions": [
    {
      "type": "screen",
