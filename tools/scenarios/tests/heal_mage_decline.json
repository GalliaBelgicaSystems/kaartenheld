{
  "name": "heal_mage_decline",
  "test": true,
  "description": "Village Heal Mage NO path: moving the cursor to NO and confirming opens the 'come back when you're hurt' follow-up with no heal, no jingle, and HEAL_MAGE_USED stays clear so the mage asks again next time.",
  "actions": [
    {
      "type": "press",
      "button": "A"
    },
    {
      "type": "wait",
      "frames": 120
    },
    {
      "type": "press",
      "button": "DOWN"
    },
    {
      "type": "wait",
      "frames": 30
    },
    {
      "type": "press",
      "button": "A"
    },
    {
      "type": "wait",
      "frames": 120
    },
    {
      "type": "press",
      "button": "A"
    },
    {
      "type": "wait",
      "frames": 120
    }
  ],
  "assertions": [
    {
      "type": "game_state",
      "expected": "OVERWORLD"
    },
    {
      "type": "party_hp",
      "expected": 3
    },
    {
      "type": "event_occurred",
      "event": "DIALOGUE_CHOICE"
    },
    {
      "type": "event_arg",
      "event": "DIALOGUE_CHOICE",
      "index": 0,
      "value": "HEAL_MAGE_ASK"
    },
    {
      "type": "event_arg",
      "event": "DIALOGUE_CHOICE",
      "index": 1,
      "value": 1
    },
    {
      "type": "event_arg",
      "event": "DIALOGUE_STARTED",
      "index": 0,
      "value": "HEAL_MAGE_DECLINED"
    },
    {
      "type": "flag",
      "flag": "HEAL_MAGE_USED",
      "expected": false
    },
    {
      "type": "event_not_occurred",
      "event": "HEALED"
    },
    {
      "type": "event_occurred",
      "event": "DIALOGUE_STARTED"
    },
    {
      "type": "event_occurred",
      "event": "DIALOGUE_ENDED"
    },
    {
      "type": "music_track",
      "expected": "TOWN"
    },
    {
      "type": "dialogue_active",
      "expected": false
    }
  ],
  "initial_state": {
    "scene": "TEST_TOWN",
    "player": {
      "x": 12,
      "y": 9,
      "facing": "DOWN"
    },
    "party": {
      "HERO": {
        "hp": 3,
        "max_hp": 10
      }
    },
    "seed": 1007,
    "flags": {
      "ARRIVED_TOWN": true
    }
  }
}
