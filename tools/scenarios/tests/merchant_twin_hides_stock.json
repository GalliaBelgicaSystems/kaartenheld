{
  "name": "merchant_twin_hides_stock",
  "test": true,
  "description": "One-copy shop stock counts ownership by card identity (docs/loot.md §34.6, AGENTS.md §52.19): owning an IRON RING loot twin (derived id 164) before ever visiting the merchant hides the curated RG4 row, so the player cannot rebuy a ring whose identity the deck cap already covers. The visible stock starts at the bow (BO9) and the steel shield (SH6) slides up behind it. Pre-fix the shop matched row ids only and kept RG4 on sale.",
  "initial_state": {
    "scene": "TEST_TOWN",
    "player": {
      "x": 10,
      "y": 3,
      "facing": "RIGHT"
    },
    "seed": 8504,
    "flags": {
      "ARRIVED_TOWN": true
    },
    "currency": {
      "GOLD": 70
    },
    "variables": {
      "MERCHANT_QUEST": 2
    }
  },
  "actions": [
    {
      "type": "collection_add",
      "card_id": 164,
      "quantity": 1
    },
    {
      "type": "wait",
      "frames": 10
    },
    {
      "type": "interact",
      "actor": "MERCHANT"
    },
    {
      "type": "wait",
      "frames": 10
    }
  ],
  "assertions": [
    {
      "type": "screen",
      "expected": "SHOP"
    },
    {
      "type": "screen_row",
      "row": 5,
      "contains": "BO9"
    },
    {
      "type": "screen_row_not_contains",
      "row": 5,
      "contains": "RG4"
    },
    {
      "type": "screen_row",
      "row": 6,
      "contains": "SH6"
    },
    {
      "type": "collection_count",
      "card_id": 164,
      "expected": 1
    },
    {
      "type": "event_not_occurred",
      "event": "CARD_PURCHASED"
    }
  ]
}
