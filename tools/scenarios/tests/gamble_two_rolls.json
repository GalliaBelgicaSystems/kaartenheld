{
  "name": "gamble_two_rolls",
  "test": true,
  "description": "The RNG stream advances across rolls: first roll deals 2/6/3, second roll deals 5/5/4 (seed 12345). Regression for the zero-state xorshift stall (AGENTS.md 52.27).",
  "actions": [
    {
      "type": "press",
      "button": "A"
    },
    {
      "type": "wait",
      "frames": 8
    },
    {
      "type": "press",
      "button": "A"
    },
    {
      "type": "wait",
      "frames": 8
    },
    {
      "type": "press",
      "button": "A"
    },
    {
      "type": "wait",
      "frames": 8
    },
    {
      "type": "press",
      "button": "A"
    },
    {
      "type": "wait",
      "frames": 8
    }
  ],
  "assertions": [
    {
      "type": "screen",
      "expected": "GAMBLE"
    },
    {
      "type": "screen_row",
      "row": 0,
      "contains": "NO LUCK"
    },
    {
      "type": "screen_row",
      "row": 10,
      "contains": "0 MATCH LOSE -1"
    },
    {
      "type": "screen_row",
      "row": 12,
      "contains": "5     5     4"
    },
    {
      "type": "currency",
      "expected": 18,
      "currency": "GOLD"
    }
  ],
  "initial_state": {
    "scene": "TEST_GAMBLE",
    "player": {
      "x": 4,
      "y": 7,
      "facing": "RIGHT"
    },
    "seed": 12345
  }
}
