      "button": "A"
    },
    {
      "type": "wait",
      "frames": 30
    },
    {
      "type": "press",
      "button": "A"
    },
    {
      "type": "wait",
      "frames": 30
    },
    {
      "type": "press",
      "button": "A"
    },
    {
      "type": "wait",
      "frames": 30
    },
    {
